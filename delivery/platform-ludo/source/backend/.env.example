NODE_ENV=production
PORT=3108
HOST=127.0.0.1
PLATFORM_MODE=true
PLATFORM_MOCK=false
MONGODB_URI=mongodb://127.0.0.1:27017/ludo_club?replicaSet=ludo
JWT_SECRET=replace-with-at-least-32-random-characters
PLATFORM_API_URL=https://platform.example.invalid
PLATFORM_API_KEY=replace-with-server-only-service-credential
PLATFORM_ADMIN_API_KEY=replace-with-separate-server-only-admin-credential
PLATFORM_COSMETIC_PRICES_JSON={}
PLATFORM_MATCH_POLICY_JSON=null
